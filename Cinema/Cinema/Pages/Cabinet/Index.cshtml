@page
@model Cinema.Pages.Cabinet.IndexModel
@{ ViewData["Title"] = "Личный кабинет"; }

<div class="page-head">
    <div>
        <h1>Личный кабинет</h1>
        <div class="muted">@Model.Me.FullName · @Model.Me.Role.Name · на сайте с @Model.Me.CreatedAt.ToString("dd.MM.yyyy")</div>
    </div>
    <a class="btn btn-accent" href="/Schedule">Купить билеты</a>
</div>

<div class="stack">
    <section>
        <h2>Мои билеты</h2>
        <nav class="chips chips-inline" aria-label="Какие билеты показать">
            @foreach (var (key, name) in new[] { ("upcoming", "Предстоящие"), ("past", "Прошедшие"), ("returned", "Возвращённые"), ("all", "Все") })
            {
                <a class="chip @(Model.Show == key ? "active" : "")" href="/Cabinet?show=@key">@name <span class="chip-count">@Model.Counts.GetValueOrDefault(key)</span></a>
            }
        </nav>
        @if (Model.Orders.Count == 0)
        {
            <div class="panel empty">
                @(Model.Show == "upcoming" ? "Предстоящих сеансов нет." : "Здесь пока пусто.")
                Выберите фильм в <a href="/Movies">афише</a> или сеанс в <a href="/Schedule">расписании</a>.
            </div>
        }
        <div class="orders">
            @foreach (var o in Model.Orders)
            {
                var can = o.Returnable(Model.Me.Id, isStaff: false);
                var s = o.Session;
                <article class="order-card @(o.AllReturned || o.Started ? "order-dim" : "")">
                    <a href="/Movies/Details/@s.MovieId" class="order-thumb"><partial name="_Poster" model="s.Movie" /></a>
                    <div class="order-body">
                        <div class="order-head">
                            <div>
                                <b class="title">@s.Movie.Title</b>
                                <span class="meta">@Fmt.Day(s.StartTime), @s.StartTime.ToString("HH:mm") · @s.Hall.Name</span>
                            </div>
                            @if (o.AllReturned) { <span class="pill pill-bad">Возвращён</span> }
                            else if (o.Started) { <span class="pill">Сеанс прошёл</span> }
                            else { <span class="pill pill-ok">Действует</span> }
                        </div>
                        <div class="seats">
                            @foreach (var t in o.Tickets)
                            {
                                var returnable = can.Contains(t);
                                <span class="seat-chip @(t.Status == TicketStatus.Returned ? "returned" : "")" title="Билет @t.Code">
                                    Ряд @t.Row · место @t.Seat
                                    @if (returnable && o.Active.Count > 1)
                                    {
                                        <form method="post" asp-page-handler="Return" asp-route-show="@Model.Show" class="inline" data-confirm="Вернуть один билет: ряд @t.Row, место @t.Seat (@Fmt.Money(t.Price))? Деньги вернутся на карту.">
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button class="seat-x" type="submit" aria-label="Вернуть билет ряд @t.Row место @t.Seat" title="Вернуть только этот билет">×</button>
                                        </form>
                                    }
                                </span>
                            }
                        </div>
                        <div class="order-foot">
                            <span class="order-sum">@o.Tickets.Count @AppPage.Plural(o.Tickets.Count, "билет", "билета", "билетов") · <b>@Fmt.Money(o.TotalSum)</b>
                                <span class="muted small">· куплено @o.First.CreatedAt.ToString("dd.MM HH:mm")</span></span>
                            <a class="btn btn-tonal btn-sm" href="/Cabinet/Receipt/@o.First.Id">Чек</a>
                            @if (can.Count > 0)
                            {
                                <form method="post" asp-page-handler="Return" asp-route-show="@Model.Show" class="inline"
                                      data-confirm="Вернуть @(can.Count == 1 ? "билет" : $"все {can.Count} {AppPage.Plural(can.Count, "билет", "билета", "билетов")} заказа") на «@s.Movie.Title» (@Fmt.Day(s.StartTime).ToLower(), @s.StartTime.ToString("HH:mm"))? На карту вернётся @Fmt.Money(can.Sum(t => t.Price)).">
                                    <input type="hidden" name="ids" value="@string.Join(",", can.Select(t => t.Id))" />
                                    <button class="btn btn-danger btn-sm" type="submit">@(can.Count == 1 ? "Вернуть билет" : "Вернуть заказ") · @Fmt.Money(can.Sum(t => t.Price))</button>
                                </form>
                            }
                            else if (o.Active.Count > 0 && !o.Started)
                            {
                                <span class="muted small">До начала меньше часа — вернуть можно только в кассе</span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>

    <div class="grid2">
        <section class="panel">
            <h2>Мои данные</h2>
            <form method="post" asp-page-handler="Profile" class="form" novalidate>
                <label class="field">Логин
                    <input value="@Model.Me.Login" disabled />
                </label>
                <label class="field">ФИО
                    <input asp-for="Profile.FullName" />
                    <span asp-validation-for="Profile.FullName" class="field-error"></span>
                </label>
                <label class="field">Электронная почта
                    <input asp-for="Profile.Email" type="email" />
                    <span asp-validation-for="Profile.Email" class="field-error"></span>
                </label>
                <div><button class="btn btn-accent" type="submit">Сохранить</button></div>
            </form>
        </section>
        <section class="panel">
            <h2>Смена пароля</h2>
            <form method="post" asp-page-handler="Password" class="form" novalidate>
                <label class="field">Текущий пароль
                    <input asp-for="Pass.Current" autocomplete="current-password" />
                    <span asp-validation-for="Pass.Current" class="field-error"></span>
                </label>
                <label class="field">Новый пароль
                    <input asp-for="Pass.New" autocomplete="new-password" />
                    <span asp-validation-for="Pass.New" class="field-error"></span>
                </label>
                <label class="field">Повтор нового пароля
                    <input asp-for="Pass.Confirm" autocomplete="new-password" />
                    <span asp-validation-for="Pass.Confirm" class="field-error"></span>
                </label>
                <div><button class="btn" type="submit">Изменить пароль</button></div>
            </form>
        </section>
    </div>
</div>

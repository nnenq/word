@page
@model ErrorModel
@{ ViewData["Title"] = "Ошибка"; }
<div class="panel" style="max-width:640px">
    @if (Model.Code == 404)
    {
        <h1>Страница не найдена</h1>
        <p>Такой страницы нет. Проверьте адрес или вернитесь на <a href="/">главную</a>.</p>
    }
    else
    {
        <h1>Что-то пошло не так</h1>
        <p>Произошла ошибка при обработке запроса (код @(Model.Code ?? 500)). Попробуйте ещё раз или вернитесь на <a href="/">главную</a>.</p>
    }
</div>

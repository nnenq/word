@page
@model Cinema.Pages.Movies.IndexModel
@{ ViewData["Title"] = "Афиша"; }

@{
    // Ссылка на жанр с сохранением остальных условий поиска
    string GenreLink(int? g) => "/Movies?" + string.Join("&", new[] {
        g == null ? null : "genre=" + g, string.IsNullOrEmpty(Model.Q) ? null : "q=" + Uri.EscapeDataString(Model.Q),
        string.IsNullOrEmpty(Model.Age) ? null : "age=" + Uri.EscapeDataString(Model.Age), Model.Today ? "today=true" : null }.Where(x => x != null));
}
<nav class="chips" aria-label="Жанры">
    <a class="chip @(Model.Genre == null ? "active" : "")" href="@GenreLink(null)">Все</a>
    @foreach (var g in Model.Genres)
    {
        <a class="chip @(Model.Genre == g.Id ? "active" : "")" href="@GenreLink(g.Id)">@g.Name</a>
    }
</nav>

<div class="page-head"><h1>Афиша</h1><span class="muted">Найдено фильмов: @Model.Movies.Count</span></div>

<form method="get" class="filters">
    @if (Model.Genre != null) { <input type="hidden" name="genre" value="@Model.Genre" /> }
    <label class="grow">Поиск по названию или режиссёру
        <input type="search" name="q" value="@Model.Q" placeholder="Например, «звёздный»" />
    </label>
    <label>Возраст
        <select name="age">
            <option value="">Любой</option>
            @foreach (var a in Movie.AgeRatings)
            {
                <option value="@a" selected="@(Model.Age == a)">@a</option>
            }
        </select>
    </label>
    <label class="check filter-check">
        <input type="checkbox" name="today" value="true" checked="@Model.Today" /> Есть сеансы сегодня
    </label>
    <div class="filter-buttons">
        <button class="btn btn-accent" type="submit">Найти</button>
        <a class="btn btn-tonal" href="/Movies">Сбросить</a>
    </div>
</form>

@if (Model.Movies.Count == 0)
{
    <div class="panel empty">По вашему запросу фильмов не найдено. Измените условия поиска.</div>
}
<div class="movies">
    @foreach (var m in Model.Movies)
    {
        <partial name="_MovieCard" model="m" />
    }
</div>

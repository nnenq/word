{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite",
    "Sqlite": "Data Source=App_Data/study.db",
    "SqlServer": "Server=.\\SQLEXPRESS;Database=StudyCabinet;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Storage": {
    "Materials": "App_Data/materials",
    "Backups": "App_Data/backups",
    "Logs": "App_Data/logs"
  },
  "Upload": {
    "MaxMegabytes": 50
  },
  "Backup": {
    "DailyAt": "21:00",
    "Keep": 14
  }
}

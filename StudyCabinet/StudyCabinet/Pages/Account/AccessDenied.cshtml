@page
@model StudyCabinet.Pages.Account.AccessDeniedModel
@{ ViewData["Title"] = "Доступ запрещён"; }
<div class="card mx-auto" style="max-width:600px"><div class="card-body p-4 text-center">
    <div class="display-6 text-danger mb-2"><i class="bi bi-shield-lock"></i></div>
    <h1 class="h4">Доступ запрещён</h1>
    <p class="text-body-secondary">@(Model.Reason ?? "У вашей учётной записи нет прав на эту страницу. Раздел преподавателя доступен только преподавателям.")</p>
    <a class="btn btn-primary" href="/">На главную</a>
</div></div>

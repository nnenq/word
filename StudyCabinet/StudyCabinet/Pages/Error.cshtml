@page
@model StudyCabinet.Pages.ErrorModel
@{ ViewData["Title"] = Model.Title; }
<div class="card mx-auto" style="max-width:640px">
    <div class="card-body p-4 text-center">
        <div class="display-6 text-body-secondary mb-2"><i class="bi @(Model.Code == 404 ? "bi-search" : "bi-exclamation-octagon")"></i></div>
        <h1 class="h3">@Model.Title</h1>
        <p class="text-body-secondary">@Model.Text</p>
        <a class="btn btn-primary" href="/">На главную</a>
    </div>
</div>

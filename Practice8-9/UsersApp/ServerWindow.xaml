<Window x:Class="UsersApp.ServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение к серверу" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="Имя сервера MS SQL Server" Style="{StaticResource Label}" Margin="0,0,0,3" />
        <TextBox x:Name="server" />
        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,6,0,0"
                   Text="Укажите то же имя сервера, что в окне «Соединение с сервером» в SSMS. Например: (localdb)\MSSQLLocalDB, .\SQLEXPRESS или DESKTOP-ABC123\SQLEXPRESS. Вход выполняется через учётную запись Windows." />
        <TextBlock x:Name="result" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Проверить" Width="100" Height="30" Margin="0,0,8,0" Click="Test_Click" />
            <Button Content="Сохранить" Width="100" Height="30" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>

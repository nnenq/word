<Window x:Class="UsersApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28,20,28,22">
        <TextBlock Text="Вход в систему" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Введите e-mail и пароль, указанные при регистрации" Foreground="#666" Margin="0,4,0,10" TextWrapping="Wrap" />

        <TextBlock Text="E-mail (логин)" Style="{StaticResource Label}" />
        <TextBox x:Name="eMail" />
        <TextBlock Text="Пароль" Style="{StaticResource Label}" />
        <PasswordBox x:Name="passw" />

        <TextBlock x:Name="error" Style="{StaticResource Error}" Visibility="Collapsed" Margin="0,8,0,0" />
        <Button x:Name="LogIn" Content="ВОЙТИ" Style="{StaticResource Primary}" Margin="0,16,0,0" IsDefault="True" Click="LogIn_Click" />

        <DockPanel Margin="0,12,0,0">
            <Button Content="Забыли пароль?" Style="{StaticResource Link}" Click="Restore_Click" DockPanel.Dock="Right" />
            <Button Content="Регистрация" Style="{StaticResource Link}" Click="Register_Click" HorizontalAlignment="Left" />
        </DockPanel>

        <Separator Margin="0,16,0,8" />
        <DockPanel>
            <Button Content="изменить" Style="{StaticResource Link}" Click="Server_Click" DockPanel.Dock="Right" FontSize="12" />
            <TextBlock x:Name="serverInfo" Foreground="#666" FontSize="12" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </StackPanel>
</Window>

<Window x:Class="UsersApp.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="28,20,28,22">
        <TextBlock Text="Восстановление пароля" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="E-mail" Style="{StaticResource Label}" />
        <DockPanel>
            <Button Content="Найти" Width="80" Margin="8,0,0,0" DockPanel.Dock="Right" Click="Find_Click" />
            <TextBox x:Name="eMail" />
        </DockPanel>
        <StackPanel x:Name="step2" Visibility="Collapsed">
            <TextBlock Text="Секретный вопрос" Style="{StaticResource Label}" />
            <TextBlock x:Name="question" TextWrapping="Wrap" FontStyle="Italic" />
            <TextBlock Text="Ответ" Style="{StaticResource Label}" />
            <TextBox x:Name="otvet" />
            <TextBlock Text="Новый пароль" Style="{StaticResource Label}" />
            <PasswordBox x:Name="passw" />
            <TextBlock Text="Повторить новый пароль" Style="{StaticResource Label}" />
            <PasswordBox x:Name="passw2" />
            <TextBlock Text="Не менее 6 символов, заглавная и строчная буквы, цифра" Foreground="#666" FontSize="12" Margin="0,4,0,0" />
            <Button Content="СМЕНИТЬ ПАРОЛЬ" Style="{StaticResource Primary}" Margin="0,14,0,0" Click="Reset_Click" />
        </StackPanel>
        <TextBlock x:Name="error" Style="{StaticResource Error}" Margin="0,10,0,0" />
    </StackPanel>
</Window>
